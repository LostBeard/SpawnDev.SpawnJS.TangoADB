@page "/"
@inject TangoService Tango
@inject NotificationService Notifications
@implements IDisposable

<RadzenText TextStyle="TextStyle.H4">Connect a device</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-mb-4" Style="color:#9aa0a6;">
    Plug an Android device (e.g. a Quest 3/3S with developer mode enabled) into this computer,
    then click Connect and approve the "Allow USB debugging?" prompt on the device.
</RadzenText>

@if (!Tango.IsWebUsbSupported)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="false">
        WebUSB is not available. Use a Chromium browser (Chrome/Edge/Opera) served over HTTPS.
    </RadzenAlert>
}

<RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" class="rz-mb-4">
    <RadzenButton Text="Connect device (WebUSB)" Icon="usb" Disabled="@busy" Click="@ConnectDevice" />
    @if (Tango.IsConnected)
    {
        <RadzenButton Text="Disconnect" Icon="link_off" ButtonStyle="ButtonStyle.Light" Disabled="@busy" Click="@Disconnect" />
    }
    @if (busy)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
    }
</RadzenStack>

@if (Tango.IsConnected)
{
    <RadzenCard Variant="Variant.Outlined">
        <RadzenText TextStyle="TextStyle.H6">Device</RadzenText>
        <table class="rz-mt-2">
            <tr><td style="padding:.2rem 1rem .2rem 0;color:#9aa0a6;">Serial</td><td>@Tango.Adb!.Serial</td></tr>
            <tr><td style="color:#9aa0a6;">Model</td><td>@model</td></tr>
            <tr><td style="color:#9aa0a6;">Manufacturer</td><td>@manufacturer</td></tr>
            <tr><td style="color:#9aa0a6;">Android</td><td>@androidVersion (SDK @sdk)</td></tr>
        </table>
        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mt-3">Device features</RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.35rem">
            @foreach (var f in Tango.Adb!.DeviceFeatures)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Info" Shade="Shade.Dark" Text="@f" />
            }
        </RadzenStack>
    </RadzenCard>
}

@code {
    bool busy;
    string model = "?", manufacturer = "?", androidVersion = "?", sdk = "?";

    protected override void OnInitialized() => Tango.ConnectionChanged += OnChanged;
    void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Tango.ConnectionChanged -= OnChanged;

    async Task ConnectDevice()
    {
        busy = true;
        try
        {
            var adb = await Tango.RequestAndConnect("TangoADB Demo");
            if (adb == null) { Notify(NotificationSeverity.Info, "Cancelled", "No device was selected."); return; }
            model = await adb.GetProp("ro.product.model");
            manufacturer = await adb.GetProp("ro.product.manufacturer");
            androidVersion = await adb.GetProp("ro.build.version.release");
            sdk = await adb.GetProp("ro.build.version.sdk");
            Notify(NotificationSeverity.Success, "Connected", model);
        }
        catch (Exception ex) { Notify(NotificationSeverity.Error, "Connect failed", ex.Message); }
        finally { busy = false; }
    }

    async Task Disconnect()
    {
        busy = true;
        try { await Tango.Disconnect(); }
        finally { busy = false; }
    }

    void Notify(NotificationSeverity severity, string summary, string detail)
        => Notifications.Notify(new NotificationMessage { Severity = severity, Summary = summary, Detail = detail, Duration = 5000 });
}
